{
	"name": "@pxseu/zerotwo",
	"version": "2.0.0",
	"description": "A stupid bot that works ",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"type": "module",
	"repository": "git@github.com:pxseu/ZeroTwo.git",
	"author": "pxseu <zerotwo@pxseu.com>",
	"license": "MPL-2.0",
	"private": true,
	"scripts": {
		"build": "bun run tsc -p tsconfig.json && bun run ./dist/publish.js",
		"clean": "rimraf dist",
		"lint": "bun run biome check src && bun run tsc --noEmit",
		"lint:fix": "bun run biome check --write src",
		"format": "bun run biome format --write src",
		"dev": "cross-env NODE_ENV=development bun --watch src/index.ts",
		"start": "cross-env NODE_ENV=production bun run ."
	},
	"dependencies": {
		"axios": "^0.24.0",
		"bufferutil": "^4.0.6",
		"cross-env": "^7.0.3",
		"discord.js": "^13.8.0",
		"erlpack": "^0.1.4",
		"imperial.js": "^2.1.6",
		"mathjs": "^11.5.0",
		"utf-8-validate": "^5.0.8",
		"zlib-sync": "^0.1.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"dotenv": "^12.0.3",
		"rimraf": "^3.0.2",
		"typescript": "^4.5.4"
	}
}
